# Flowmix 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# Redis 配置
REDIS_PASSWORD=your_strong_password_here
REDIS_URL=redis://:your_strong_password_here@localhost:6379/0

# PostgreSQL 配置
POSTGRES_DB=flowmix
POSTGRES_USER=flowmix
POSTGRES_PASSWORD=flowmix_password
POSTGRES_DSN=postgresql://flowmix:flowmix_password@localhost/flowmix

# Worker 配置
NUM_WORKERS=4
WORKER_ID=worker-1

# 日志配置
LOG_LEVEL=INFO
